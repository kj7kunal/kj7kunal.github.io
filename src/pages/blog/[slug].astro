---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { calculateReadingTime, extractKeywords } from '../../utils/seo.ts';

export async function getStaticPaths() {
  const lifePosts = await getCollection('life');
  const experimentsPosts = await getCollection('experiments');
  const mlPosts = await getCollection('ml');
  const allPosts = [...lifePosts, ...experimentsPosts, ...mlPosts];
  
  return allPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Calculate reading time and extract additional keywords
const readingTime = calculateReadingTime(post.body);
const contentKeywords = extractKeywords(post.body, 5);
const allTags = [...(post.data.tags || []), ...contentKeywords];

// Determine category from collection
const category = post.collection;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date}
  tags={allTags}
  category={category}
  readingTime={readingTime}
>
  <Header />
  
  <main class="container mx-auto px-6 pt-24 lg:pt-32">
    <article class="max-w-4xl mx-auto">
      <header class="mb-12">
        <div class="flex items-center gap-4 mb-6">
          <span class={`px-3 py-1 text-sm rounded-full ${
            post.collection === 'ml' 
              ? 'bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-200' 
              : post.data.category === 'experiments'
                ? 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200'
                : 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200'
          }`}>
            {post.collection === 'ml' ? 'ML' : post.data.category}
          </span>
          <time class="text-gray-500 dark:text-gray-400">
            {new Date(post.data.date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
        </div>
        
        <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-white">{post.data.title}</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">{post.data.description}</p>
        
        {post.data.tags && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 px-3 py-1 text-sm rounded-full">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>
      
      <div class="prose prose-lg max-w-none dark:prose-invert 
        prose-headings:font-bold prose-headings:text-gray-900 dark:prose-headings:text-white
        prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline 
        prose-blockquote:border-l-blue-400 dark:prose-blockquote:border-l-blue-500 prose-blockquote:bg-gray-50 dark:prose-blockquote:bg-gray-800 prose-blockquote:rounded-r-lg
        prose-strong:text-gray-900 dark:prose-strong:text-white
        dark:prose-ul:ml-7 dark:prose-ol:ml-7
        prose-li:marker:text-blue-500
        prose-pre:bg-gray-900 dark:prose-pre:bg-gray-950 prose-pre:border prose-pre:border-gray-700">
        <Content />
      </div>
      
      <footer class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
        <nav class="flex justify-between">
          <a href="/blog" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 transition-colors">
            ← Back to Blog
          </a>
        </nav>
      </footer>
    </article>
  </main>
  
  <Footer />
</Layout>
