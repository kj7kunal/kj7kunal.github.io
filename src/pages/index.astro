---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Storyboard from '../components/Storyboard.astro';
import DigitalZine from '../components/DigitalZine.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Kunal Jain | Machine Learning Engineer">
  <Header />
  
  <!-- Responsive main container -->
  <main class="w-full">
    <!-- Hero Section -->
    <section id="hero" class="min-h-screen flex items-center justify-center py-8 md:py-16">
      <div class="container">
        <Hero />
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="min-h-screen flex items-center justify-center py-8 md:py-16">
      <div class="container">
        <About />
      </div>
    </section>

    <!-- Storyboard Section -->
    <section id="storyboard" class="min-h-screen flex items-center justify-center py-8 md:py-16">
      <div class="container">
        <Storyboard />
      </div>
    </section>
    
    <!-- DigitalZine Section -->
    <section id="zine" class="min-h-screen flex items-center justify-center py-8 md:py-16">
      <div class="container">
        <DigitalZine />
      </div>
    </section>
    
    <!-- Footer -->
    <Footer />
  </main>
</Layout>
