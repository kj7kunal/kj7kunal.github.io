---
// Signal boost section component
---

<div class="w-full h-full flex items-center justify-center">
  <div class="container-fluid">
    <!-- Section Header -->
    <div class="text-center mb-fluid-xl">
      <h2 class="text-fluid-6xl font-bold gradient-text mb-fluid-sm">Signal Boost</h2>
      <p class="text-fluid-xl text-gray-600 dark:text-gray-400">Latest updates and activities</p>
    </div>
    
    <!-- Content Card -->
    <div class="card max-w-none">
      <div class="grid md:grid-cols-2 space-fluid-lg">
        <div class="flex items-start space-fluid-md">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500 dark:text-soft-lilac flex-shrink-0 mt-1" style="width: clamp(1.5rem, 3vw, 2rem); height: clamp(1.5rem, 3vw, 2rem);">
            <path d="M12 22h6a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v5"></path>
            <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
            <path d="M2 15h2"></path>
            <path d="M2 19h2"></path>
            <path d="M6.5 13H8"></path>
            <path d="M6.5 17H8"></path>
          </svg>
          <div>
            <h4 class="font-bold text-fluid-xl mb-fluid-xs text-indigo-500 dark:text-soft-lilac">Latest Post</h4>
            <p class="text-fluid-lg text-text-dark dark:text-snow">Reflections on Career Pivots</p>
            <span class="text-fluid-sm text-gray-500 dark:text-snow/50">via Medium</span>
          </div>
        </div>
        <div class="flex items-start space-fluid-md">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500 dark:text-soft-lilac flex-shrink-0 mt-1" style="width: clamp(1.5rem, 3vw, 2rem); height: clamp(1.5rem, 3vw, 2rem);">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          <div>
            <h4 class="font-bold text-fluid-xl mb-fluid-xs text-indigo-500 dark:text-soft-lilac">Latest Commit</h4>
            <p class="text-fluid-lg text-text-dark dark:text-snow">jainkunal/llm-finetuning-rd</p>
            <span class="text-fluid-sm text-gray-500 dark:text-snow/50">Updated README.md</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
